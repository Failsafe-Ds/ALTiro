# Plantilla procesada por el entrypoint de la imagen oficial de Nginx (envsubst):
# solo se sustituyen variables de entorno definidas (ALTIRO_HTTPS_PORT);
# las variables propias de Nginx ($host, $uri, ...) quedan intactas.
# ADR-008: único punto de entrada, HTTPS local autofirmado, sin HSTS.

server_tokens off;

# Registro de acceso sin la cadena de consulta (RNF-06, ADR-015): el enlace de
# descarga de un documento lleva su token en "?t=…" y no debe quedar en los
# registros. Se usa la ruta de $request_uri sin la consulta (conserva la ruta
# original aunque luego haya una redirección interna, como las páginas de
# error) y el Referer también sin consulta. Se declara en cada server: un
# access_log a nivel http se sumaría al formato "main" de nginx.conf, que
# escribe $request completo.
map $request_uri $altiro_ruta_sin_consulta {
    "~^(?<ruta>[^?]*)" $ruta;
    default            "-";
}
map $http_referer $altiro_referer_sin_consulta {
    "~^(?<base>[^?]*)" $base;
    default            "-";
}
log_format altiro_sin_consulta '$remote_addr - $remote_user [$time_local] '
                               '"$request_method $altiro_ruta_sin_consulta $server_protocol" '
                               '$status $body_bytes_sent "$altiro_referer_sin_consulta" "$http_user_agent"';

# Puerto 80: solo redirige a HTTPS. 307 (temporal) para no quedar en la caché
# del navegador como ocurriría con un 301.
server {
    listen 80 default_server;
    server_name _;
    access_log /var/log/nginx/access.log altiro_sin_consulta;

    return 307 https://$host:${ALTIRO_HTTPS_PORT}$request_uri;
}

server {
    listen 443 ssl default_server;
    http2 on;
    server_name _;
    access_log /var/log/nginx/access.log altiro_sin_consulta;

    ssl_certificate     /etc/nginx/certificados/cert.pem;
    ssl_certificate_key /etc/nginx/certificados/key.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # Cabeceras de seguridad emitidas en un solo lugar (ADR-008).
    # Sin Strict-Transport-Security en la demostración.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;

    root  /usr/share/nginx/html;
    index index.html;

    # Páginas de error propias, en español y sin texto técnico (DEF-QA-006,
    # RNF-15, CLAUDE.md §9). Se conserva el código HTTP; un 403 (por ejemplo,
    # una carpeta sin index.html) se responde como 404 para no revelar qué existe.
    error_page 403 =404 /errores/404.html;
    error_page 404 /errores/404.html;
    error_page 500 502 503 504 /errores/50x.html;

    # Solo se entregan como respuesta a un error, no al pedirlas directamente.
    location ^~ /errores/ {
        internal;
    }

    # API JSON (ADR-002).
    location /api/ {
        proxy_pass http://app:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Origen del intento para el limitador (RNF-10, ADR-007). Se sobrescribe
        # siempre: el cliente no puede inyectar su propio X-Real-IP.
        proxy_set_header X-Real-IP $remote_addr;

        # Evita cabeceras duplicadas: estas las emite Nginx arriba.
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header Referrer-Policy;
        proxy_hide_header Strict-Transport-Security;

        # Errores que genera el propio Nginx (cuerpo demasiado grande, app caída
        # o que no responde): JSON con el formato común { mensaje, errores } que
        # entiende js/api.js (DEF-QA-006, RNF-15). Sin proxy_intercept_errors,
        # las respuestas de la app (400, 404, 500 en JSON) pasan sin cambios.
        error_page 413 @api_413;
        error_page 500 502 503 504 @api_no_disponible;
    }

    # Subida de documentos del maestro (ADR-015, D-5): la única ruta con más de
    # 1 MB. Dos fotos de hasta 8 MB (anverso y reverso de la cédula) más el
    # resto del formulario: 17 MB, igual que FILE_UPLOAD_MAX_MEMORY_SIZE en
    # Django. client_body_buffer_size igual al máximo: Nginx guarda el cuerpo en
    # memoria y no escribe la foto en un archivo temporal en disco. Mismas
    # cabeceras y errores en JSON que /api/.
    location = /api/maestros/expediente/documentos {
        client_max_body_size 17m;
        client_body_buffer_size 17m;

        proxy_pass http://app:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;

        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header Referrer-Policy;
        proxy_hide_header Strict-Transport-Security;

        error_page 413 @api_413_documentos;
        error_page 500 502 503 504 @api_no_disponible;
    }

    # Descarga de la foto de un documento (RNF-06, ADR-015; DEF-QA-009). Es la
    # única ruta que entrega documentos o fotos privadas, y su URL lleva el
    # token del enlace de 600 s en "?t=…". El regex cubre cualquier <ref>.
    # - Cuerpo nunca en el disco del proxy: proxy_max_temp_file_size 0 prohíbe
    #   el archivo temporal (/var/cache/nginx/proxy_temp) y los buffers en
    #   memoria (8 MB, el máximo por archivo de ADR-015) liberan pronto al
    #   worker de la app aunque el cliente sea lento. Si una respuesta los
    #   supera, Nginx espera a que el cliente lea; nunca escribe a disco.
    # - Sin error_log: Nginx escribe en cada aviso o error la línea de petición
    #   completa (con el token) y log_format no se aplica al error_log. En esta
    #   ruta no se registra nada de Nginx; los errores de la descarga los
    #   registra la aplicación sin la consulta, y una app caída se ve en los
    #   errores de las demás rutas.
    location ~ ^/api/documentos/[^/]+/archivo$ {
        error_log /dev/null;

        proxy_max_temp_file_size 0;
        proxy_buffer_size 16k;
        proxy_buffers 32 256k;
        proxy_busy_buffers_size 512k;

        proxy_pass http://app:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;

        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header Referrer-Policy;
        proxy_hide_header Strict-Transport-Security;

        error_page 500 502 503 504 @api_no_disponible;
    }

    location @api_413_documentos {
        default_type application/json;
        return 413 '{"mensaje": "Las fotos son demasiado pesadas: cada una puede pesar hasta 8 MB. Tómalas de nuevo con menos resolución.", "errores": {}}';
    }

    location @api_413 {
        default_type application/json;
        return 413 '{"mensaje": "Lo que enviaste es demasiado grande. Reduce su tamaño e inténtalo de nuevo.", "errores": {}}';
    }

    location @api_no_disponible {
        default_type application/json;
        return 503 '{"mensaje": "AlTiro no está disponible en este momento. Espera unos minutos e inténtalo de nuevo.", "errores": {}}';
    }

    # Frontend estático (HTML, CSS, JS).
    location / {
        try_files $uri $uri/ =404;
    }
}
