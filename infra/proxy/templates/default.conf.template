# Plantilla procesada por el entrypoint de la imagen oficial de Nginx (envsubst):
# solo se sustituyen variables de entorno definidas (ALTIRO_HTTPS_PORT);
# las variables propias de Nginx ($host, $uri, ...) quedan intactas.
# ADR-008: único punto de entrada, HTTPS local autofirmado, sin HSTS.

server_tokens off;

# Registro de acceso sin la cadena de consulta (RNF-06, ADR-015): el enlace de
# descarga de un documento lleva su token en "?t=…" y no debe quedar en los
# registros. Se usa la ruta de $request_uri sin la consulta (conserva la ruta
# original aunque luego haya una redirección interna, como las páginas de
# error) y el Referer también sin consulta. Se declara en cada server: un
# access_log a nivel http se sumaría al formato "main" de nginx.conf, que
# escribe $request completo.
map $request_uri $altiro_ruta_sin_consulta {
    "~^(?<ruta>[^?]*)" $ruta;
    default            "-";
}
map $http_referer $altiro_referer_sin_consulta {
    "~^(?<base>[^?]*)" $base;
    default            "-";
}
log_format altiro_sin_consulta '$remote_addr - $remote_user [$time_local] '
                               '"$request_method $altiro_ruta_sin_consulta $server_protocol" '
                               '$status $body_bytes_sent "$altiro_referer_sin_consulta" "$http_user_agent"';

# --- Limitación de solicitudes contra inundación (ADR-029) ---
# Capa extra frente a ráfagas y fuerza bruta. NO reemplaza el limitador de
# intentos fallidos por cuenta y origen de la app (RNF-10, ADR-007), que sigue
# igual. Clave: la IP de quien conecta al proxy. En Docker Desktop todos los
# clientes del equipo anfitrión llegan con la IP del gateway, así que los
# umbrales son holgados (ver ADR-029).
# - general: todo el sitio (páginas, JS, CSS y API). 100 solicitudes/s con
#   ráfaga de 200 sin espera: sobre el pico legítimo medido (RNF-01: 10 hilos
#   de búsqueda, unas 50/s; una página con sus JS y CSS son unas 12) y bajo una
#   inundación desde un solo origen.
# - estricta: solo POST de inicio de sesión, registro y recuperación. 20 por
#   minuto con ráfaga de 30 sin espera: 10 personas tras la misma IP pueden
#   ingresar a la vez, y la ráfaga es mayor que los 20 fallos por origen de
#   ADR-007, para que el bloqueo de la app siga siendo el primero en actuar.
#   Los GET de esas rutas usan clave vacía y no se cuentan.
map $request_method $altiro_clave_estricta {
    POST    $binary_remote_addr;
    default "";
}
limit_req_zone $binary_remote_addr     zone=altiro_general:10m  rate=100r/s;
limit_req_zone $altiro_clave_estricta  zone=altiro_estricta:10m rate=20r/m;
limit_conn_zone $binary_remote_addr    zone=altiro_conexiones:10m;
limit_req_status 429;
limit_conn_status 429;
# El aviso de Nginx en error_log incluiría la línea de petición con su
# consulta, la IP y el Referer: se baja a "info" (no se escribe con el nivel
# "notice" de la imagen). El rechazo se registra en access_log, abajo.
limit_req_log_level info;
limit_conn_log_level info;

# Registro de rechazos (429) sin IP, sin agente ni consulta: solo fecha,
# método, ruta y qué limitador actuó (REJECTED en req o conn = proxy; PASSED
# en ambos = 429 propio de la app, ADR-007). Las demás respuestas van al
# formato altiro_sin_consulta.
map $status $altiro_es_429 {
    429     1;
    default 0;
}
map $status $altiro_no_es_429 {
    429     0;
    default 1;
}
log_format altiro_limitacion '[$time_local] limitacion 429 '
                             '"$request_method $altiro_ruta_sin_consulta" '
                             'req=$limit_req_status conn=$limit_conn_status';

# Redirección http->https (hallazgo B-2, ADR-029): el nombre de destino no se
# toma tal cual de la petición. Solo se conservan localhost y las IPv4 de
# loopback o de red privada (acceso desde teléfonos de la red local con
# ALTIRO_BIND_ADDR, ADR-008); cualquier otro Host redirige a localhost.
map $host $altiro_host_redireccion {
    "localhost"                                         "localhost";
    "~^127\.\d{1,3}\.\d{1,3}\.\d{1,3}$"                 $host;
    "~^10\.\d{1,3}\.\d{1,3}\.\d{1,3}$"                  $host;
    "~^192\.168\.\d{1,3}\.\d{1,3}$"                     $host;
    "~^172\.(1[6-9]|2\d|3[01])\.\d{1,3}\.\d{1,3}$"      $host;
    default                                             "localhost";
}

# Puerto 80: solo redirige a HTTPS. 307 (temporal) para no quedar en la caché
# del navegador como ocurriría con un 301.
server {
    listen 80 default_server;
    server_name _;
    access_log /var/log/nginx/access.log altiro_sin_consulta;

    client_header_timeout 10s;
    client_body_timeout 10s;
    keepalive_timeout 15s;

    return 307 https://$altiro_host_redireccion:${ALTIRO_HTTPS_PORT}$request_uri;
}

server {
    listen 443 ssl default_server;
    http2 on;
    server_name _;
    access_log /var/log/nginx/access.log altiro_sin_consulta if=$altiro_no_es_429;
    access_log /var/log/nginx/access.log altiro_limitacion if=$altiro_es_429;

    ssl_certificate     /etc/nginx/certificados/cert.pem;
    ssl_certificate_key /etc/nginx/certificados/key.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # Cabeceras de seguridad emitidas en un solo lugar (ADR-008; B-3, ADR-029).
    include /etc/nginx/conf.d/altiro-cabeceras.inc;

    # Limitación por origen (ADR-029). Las locations sin limit_req propio
    # heredan estas; las rutas estrictas repiten la general.
    limit_req zone=altiro_general burst=200 nodelay;
    limit_conn altiro_conexiones 50;

    # Conexiones lentas (ADR-029). Los tiempos de cuerpo y de envío se miden
    # entre dos lecturas o escrituras sucesivas, no en total: una foto de 8 MB
    # con señal débil sigue subiendo mientras avance (RNF-20).
    client_header_timeout 10s;
    client_body_timeout 30s;
    send_timeout 30s;
    keepalive_timeout 30s;
    reset_timedout_connection on;
    # Cuerpo máximo general: 1 MB (JSON). Solo las subidas de documentos
    # (17 MB) y de la foto (9 MB) lo amplían en su location.
    client_max_body_size 1m;

    root  /usr/share/nginx/html;
    index index.html;

    # Compresión (RNF-02: presupuesto de JS y JSON en red móvil; propuesta del S4, §6).
    # Solo texto: HTML (siempre incluido), CSS, JS, JSON y SVG. Las imágenes y las
    # descargas de documentos no se comprimen (son binarios y no están en la
    # lista). gzip_proxied any: también las respuestas JSON de la app.
    # No se comprime la respuesta que lleva el token de un enlace firmado
    # (location de los enlaces, más abajo): un secreto dentro de una respuesta
    # comprimida puede adivinarse midiendo su tamaño (BREACH).
    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_vary on;
    gzip_types text/css application/javascript text/javascript application/json image/svg+xml;

    # Páginas de error propias, en español y sin texto técnico (DEF-QA-006,
    # RNF-15, CLAUDE.md §9). Se conserva el código HTTP; un 403 (por ejemplo,
    # una carpeta sin index.html) se responde como 404 para no revelar qué existe.
    error_page 403 =404 /errores/404.html;
    error_page 404 /errores/404.html;
    error_page 500 502 503 504 /errores/50x.html;
    error_page 429 /errores/429.html;

    # Solo se entregan como respuesta a un error, no al pedirlas directamente.
    # Nunca quedan en caché: al reintentar debe verse la página real.
    location ^~ /errores/ {
        internal;
        include /etc/nginx/conf.d/altiro-cabeceras.inc;
        add_header Cache-Control "no-store" always;
    }

    # Inicio de sesión, registro y recuperación (ADR-029): límite estricto por
    # origen para POST, además del general. Rutas de backend/altiro/urls.py.
    location = /api/sesion {
        limit_req zone=altiro_general burst=200 nodelay;
        limit_req zone=altiro_estricta burst=30 nodelay;
        error_page 413 @api_413;
        include /etc/nginx/conf.d/altiro-api.inc;
    }
    location = /api/clientes {
        limit_req zone=altiro_general burst=200 nodelay;
        limit_req zone=altiro_estricta burst=30 nodelay;
        error_page 413 @api_413;
        include /etc/nginx/conf.d/altiro-api.inc;
    }
    location = /api/maestros/postulaciones {
        limit_req zone=altiro_general burst=200 nodelay;
        limit_req zone=altiro_estricta burst=30 nodelay;
        error_page 413 @api_413;
        include /etc/nginx/conf.d/altiro-api.inc;
    }
    location = /api/recuperacion {
        limit_req zone=altiro_general burst=200 nodelay;
        limit_req zone=altiro_estricta burst=30 nodelay;
        error_page 413 @api_413;
        include /etc/nginx/conf.d/altiro-api.inc;
    }
    location = /api/recuperacion/contrasena {
        limit_req zone=altiro_general burst=200 nodelay;
        limit_req zone=altiro_estricta burst=30 nodelay;
        error_page 413 @api_413;
        include /etc/nginx/conf.d/altiro-api.inc;
    }

    # API JSON (ADR-002).
    # Paso a la app, cabeceras y errores 429/50x en JSON: altiro-api.inc.
    location /api/ {
        include /etc/nginx/conf.d/altiro-api.inc;
        error_page 413 @api_413;
    }

    # Subida de documentos del maestro (ADR-015, D-5): la única ruta con más de
    # 1 MB. Dos fotos de hasta 8 MB (anverso y reverso de la cédula) más el
    # resto del formulario: 17 MB, igual que FILE_UPLOAD_MAX_MEMORY_SIZE en
    # Django. client_body_buffer_size igual al máximo: Nginx guarda el cuerpo en
    # memoria y no escribe la foto en un archivo temporal en disco. Mismas
    # cabeceras y errores en JSON que /api/.
    location = /api/maestros/expediente/documentos {
        client_max_body_size 17m;
        client_body_buffer_size 17m;

        include /etc/nginx/conf.d/altiro-api.inc;

        error_page 413 @api_413_documentos;
    }

    # Enlaces firmados de 600 s de un documento (RNF-06, ADR-015; ADR-017, E-3):
    # la respuesta JSON lleva el token, así que va sin compresión (BREACH).
    location ~ ^/api/(curatoria/)?documentos/[^/]+/enlace$ {
        gzip off;

        include /etc/nginx/conf.d/altiro-api.inc;

    }

    # Descarga de la foto de un documento (RNF-06, ADR-015; DEF-QA-009). Es la
    # única ruta que entrega documentos o fotos privadas, y su URL lleva el
    # token del enlace de 600 s en "?t=…". El regex cubre cualquier <ref>.
    # - Cuerpo nunca en el disco del proxy: proxy_max_temp_file_size 0 prohíbe
    #   el archivo temporal (/var/cache/nginx/proxy_temp) y los buffers en
    #   memoria (8 MB, el máximo por archivo de ADR-015) liberan pronto al
    #   worker de la app aunque el cliente sea lento. Si una respuesta los
    #   supera, Nginx espera a que el cliente lea; nunca escribe a disco.
    # - Sin error_log: Nginx escribe en cada aviso o error la línea de petición
    #   completa (con el token) y log_format no se aplica al error_log. En esta
    #   ruta no se registra nada de Nginx; los errores de la descarga los
    #   registra la aplicación sin la consulta, y una app caída se ve en los
    #   errores de las demás rutas.
    location ~ ^/api/documentos/[^/]+/archivo$ {
        error_log /dev/null;
        # Descarga binaria de un documento: nunca se comprime.
        gzip off;

        proxy_max_temp_file_size 0;
        proxy_buffer_size 16k;
        proxy_buffers 32 256k;
        proxy_busy_buffers_size 512k;

        include /etc/nginx/conf.d/altiro-api.inc;

    }

    # Subida de la foto del maestro (ADR-021, punto 4; patrón de ADR-015, D-5):
    # una foto de hasta 8 MB más el resto del formulario, 9 MB, igual que
    # MAXIMO_CUERPO_FOTO en Django. client_body_buffer_size igual al máximo:
    # el cuerpo queda en memoria y nunca se escribe en un temporal del disco.
    # La ruta no lleva consulta ni token; el registro de acceso ya omite la
    # consulta.
    location = /api/maestros/perfil/foto {
        client_max_body_size 9m;
        client_body_buffer_size 9m;

        include /etc/nginx/conf.d/altiro-api.inc;

        error_page 413 @api_413_foto;
    }

    # Foto pública de un maestro publicado (ADR-021, punto 3). Variantes de
    # 160 y 480 px (decenas de KB): buffers en memoria y sin temporal en disco.
    location ~ ^/api/maestros/publicos/[^/]+/foto$ {
        proxy_max_temp_file_size 0;
        proxy_buffer_size 16k;
        proxy_buffers 16 64k;
        proxy_busy_buffers_size 128k;

        include /etc/nginx/conf.d/altiro-api.inc;

    }

    location @api_413_foto {
        default_type application/json;
        return 413 '{"mensaje": "La foto es muy pesada. Tómala de nuevo o elige otra.", "errores": {}}';
    }

    location @api_413_documentos {
        default_type application/json;
        return 413 '{"mensaje": "Las fotos son demasiado pesadas: cada una puede pesar hasta 8 MB. Tómalas de nuevo con menos resolución.", "errores": {}}';
    }

    location @api_413 {
        default_type application/json;
        return 413 '{"mensaje": "Lo que enviaste es demasiado grande. Reduce su tamaño e inténtalo de nuevo.", "errores": {}}';
    }

    # Rechazo del limitador del proxy (ADR-029). Retry-After fijo: 30 s bastan
    # para recuperar la ráfaga general y 10 cupos de la estricta.
    location @api_429 {
        include /etc/nginx/conf.d/altiro-cabeceras.inc;
        add_header Retry-After "30" always;
        add_header Cache-Control "no-store" always;
        default_type application/json;
        return 429 '{"mensaje": "Recibimos demasiadas solicitudes seguidas desde tu conexión. Espera 30 segundos y vuelve a intentarlo. Lo que escribiste sigue aquí.", "errores": {}}';
    }

    location @api_no_disponible {
        default_type application/json;
        return 503 '{"mensaje": "AlTiro no está disponible en este momento. Espera unos minutos e inténtalo de nuevo.", "errores": {}}';
    }

    # Frontend estático (HTML, CSS, JS). Hallazgo B-1 (ADR-029): "no-cache"
    # obliga a revalidar con ETag/Last-Modified (que Nginx envía siempre); si
    # el archivo no cambió, la respuesta es un 304 sin cuerpo (RNF-02). Los
    # nombres de JS y CSS no llevan versión, por eso no se usa max-age.
    location / {
        include /etc/nginx/conf.d/altiro-cabeceras.inc;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ =404;
    }
}
