# Ejemplo de configuración (ADR-009). NO es necesario copiarlo:
# docker-compose.yml trae estos mismos valores por defecto.
# Para cambiar alguno, cree un archivo .env (no versionado) con las variables
# que quiera sobrescribir. Aquí no van secretos: los genera el servicio "init".

# --- Publicación del proxy (ADR-008) ---
# 127.0.0.1 = solo este equipo. Para exponer a la red local, usar la IP del equipo.
ALTIRO_BIND_ADDR=127.0.0.1
ALTIRO_HTTP_PORT=80
ALTIRO_HTTPS_PORT=443

# SAN del certificado autofirmado. Si expone a la red local, agregue la IP o el
# nombre del equipo, por ejemplo: DNS:localhost,IP:127.0.0.1,IP:192.168.1.50
# Al cambiarlo, el servicio "init" regenera el certificado.
ALTIRO_TLS_SAN=DNS:localhost,IP:127.0.0.1

# --- Django ---
DJANGO_DEBUG=false
# Mantener 127.0.0.1: lo usa la verificación de salud interna del contenedor.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Si usa otro puerto HTTPS, inclúyalo (por ejemplo https://localhost:8443).
DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost,https://127.0.0.1
GUNICORN_WORKERS=2
# Expiración de la sesión por inactividad, en segundos (RNF-09: 30 minutos).
ALTIRO_SESION_INACTIVIDAD_SEGUNDOS=1800

# --- PostgreSQL (las contraseñas las genera "init" en el volumen de secretos) ---
POSTGRES_DB=altiro
# Rol administrativo (superusuario de la imagen): solo inicializa la base.
POSTGRES_USER=altiro_admin
# Rol con que se conecta la aplicación (sin superusuario). Debe ser distinto
# de POSTGRES_USER. Se crea solo al inicializar un volumen datos_db vacío (ver README).
ALTIRO_DB_APP_USER=altiro_app

# Registros del servidor PostgreSQL sin datos personales (ADR-003, E-1).
# panic = no escribe la sentencia que falló; terse = sin DETAIL/HINT/CONTEXT/QUERY.
# "error" / "default" solo para diagnóstico local con datos ficticios;
# después, volver a estos valores seguros (docker compose up -d db).
ALTIRO_DB_LOG_MIN_ERROR_STATEMENT=panic
ALTIRO_DB_LOG_ERROR_VERBOSITY=terse

# --- Respaldo diario (RNF-19; ADR-026, E-7) ---
# Hora local (HH:MM) del respaldo diario y su zona horaria.
ALTIRO_RESPALDO_HORA=03:00
ALTIRO_RESPALDO_ZONA_HORARIA=America/Santiago
# Días que se conservan los respaldos (RNF-19: 7).
ALTIRO_RESPALDO_RETENCION_DIAS=7
# Directorio local de los respaldos, FUERA del repositorio (relativo a este archivo).
# La clave de cifrado de documentos (volumen de secretos) NO va en los respaldos:
# el equipo la respalda por separado, en otro lugar.
ALTIRO_RESPALDO_DIR=../altiro-respaldos

# --- Retención de documentos del maestro (RNF-26; ADR-026, E-9) ---
# Días desde que el expediente quedó rechazado o suspendido. Vacío = sin plazo:
# no se elimina nada y el planificador registra una advertencia (P-30).
# Pendiente de V-04/P-07: ver docs/alcance/plazos-retencion.md. No inventar valores.
RETENCION_DIAS_CEDULA_IDENTIDAD=
RETENCION_DIAS_CERTIFICADO_ANTECEDENTES=
RETENCION_DIAS_LICENCIA_SEC=

# --- Correos y recuperación de contraseña (ADR-027) ---
# Dirección con la que se arman los enlaces de los correos (buzón local en el volumen "buzon").
ALTIRO_URL_PUBLICA=https://localhost
# Minutos que sirve un enlace de recuperación.
ALTIRO_RECUPERACION_MINUTOS=30
